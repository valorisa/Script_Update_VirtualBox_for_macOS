#!/bin/bash
#===============================================================================
# Script de Mise à Jour VirtualBox pour macOS (CLI)
# Version: 2.0.0
# Auteur: valorisa
# Licence: MIT
# Description: Automatise l'installation/mise à jour de VirtualBox 7.x sur macOS
# Compatibilité: macOS 12+ (Monterey), Intel & Apple Silicon (M1/M2/M3)
#===============================================================================

# ⚙️ Options de sécurité Bash
set -euo pipefail          # Exit on error, undefined vars, pipe failures
IFS=$'\n\t'                # Séparateur de champ sécurisé
umask 077                  # Permissions restrictives pour les fichiers créés

# 🎨 Couleurs pour la sortie terminal (désactivables)
readonly RED='\033[0;31m'
readonly GREEN='\033[0;32m'
readonly YELLOW='\033[1;33m'
readonly BLUE='\033[0;34m'
readonly NC='\033[0m' # No Color

# 📋 Variables globales
readonly SCRIPT_NAME="$(basename "$0")"
readonly SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly DOWNLOAD_DIR="${VBOX_DOWNLOAD_DIR:-${HOME}/Downloads}"
readonly TEMP_DIR="${TMPDIR:-/tmp}/vbox-update-$$"
readonly LOG_FILE="${HOME}/Library/Logs/vbox-update.log"

# 🎛 Options configurables (valeurs par défaut)
VERSION=""
BUILD=""
SKIP_EXTPACK=false
DRY_RUN=false
VERBOSE=false
CLEANUP=false
AUTO_VERSION=false

# 🔄 Variables d'état
MOUNTDIR=""
DOWNLOADED_FILES=()

#===============================================================================
# 📢 Fonctions de Logging & Affichage
#===============================================================================

log() {
    local level="$1"
    shift
    local message="$*"
    local timestamp
    timestamp="$(date '+%Y-%m-%d %H:%M:%S')"
    
    # Écrire dans le fichier de log
    echo "[$timestamp] [$level] $message" >> "$LOG_FILE" 2>/dev/null || true
    
    # Afficher selon le niveau de verbosité
    if [[ "$VERBOSE" == true ]] || [[ "$level" != "DEBUG" ]]; then
        case "$level" in
            ERROR)   echo -e "${RED}❌ [$level] $message${NC}" >&2 ;;
            SUCCESS) echo -e "${GREEN}✅ [$level] $message${NC}" ;;
            WARNING) echo -e "${YELLOW}⚠️  [$level] $message${NC}" ;;
            INFO)    echo -e "${BLUE}ℹ️  [$level] $message${NC}" ;;
            DEBUG)   [[ "$VERBOSE" == true ]] && echo -e "🔍 [$level] $message" ;;
        esac
    fi
}

info()    { log "INFO" "$*"; }
success() { log "SUCCESS" "$*"; }
warning() { log "WARNING" "$*"; }
error()   { log "ERROR" "$*"; }
debug()   { log "DEBUG" "$*"; }

print_banner() {
    cat << 'EOF'
╔══════════════════════════════════════════════════════════════╗
║  🔄 VirtualBox Updater for macOS — Version 2.0                ║
║  Automatisation sécurisée de l'installation VirtualBox 7.x   ║
╚══════════════════════════════════════════════════════════════╝
EOF
}

show_help() {
    cat << EOF
📖 Utilisation: $SCRIPT_NAME [OPTIONS]

OPTIONS:
    --version <X.Y.Z>       Version cible de VirtualBox (ex: 7.0.12)
    --build <NUMBER>        Numéro de build Oracle (ex: 150234)
    --auto-version          Détecter automatiquement la dernière version
    --skip-extpack          Ne pas installer l'Extension Pack
    --dry-run               Afficher les commandes sans les exécuter
    --verbose               Activer la sortie détaillée (debug)
    --cleanup               Supprimer les fichiers téléchargés après installation
    --download-dir <PATH>   Dossier de téléchargement personnalisé
    --help                  Afficher cette aide et quitter

EXEMPLES:
    # Mode interactif
    $ $SCRIPT_NAME

    # Mode non-interactif avec version spécifique
    $ $SCRIPT_NAME --version 7.0.12 --build 150234

    # Détection automatique + mode simulation
    $ $SCRIPT_NAME --auto-version --dry-run --verbose

    # Installation silencieuse avec nettoyage
    $ $SCRIPT_NAME --version 7.0.12 --build 150234 --skip-extpack --cleanup

NOTES:
    • Requiert les droits administrateur (sudo) pour l'installation
    • VirtualBox doit être fermé avant l'exécution
    • Les fichiers sont téléchargés depuis download.virtualbox.org (HTTPS)
    • Compatible Intel et Apple Silicon (M1/M2/M3)

EOF
}

#===============================================================================
# 🔍 Fonctions de Validation & Détection
#===============================================================================

detect_architecture() {
    local arch
    arch="$(uname -m)"
    case "$arch" in
        arm64)
            info "Architecture détectée: Apple Silicon ($arch)"
            warning "VirtualBox sur Apple Silicon : seules les VM ARM64 sont pleinement supportées"
            warning "L'émulation x86_64 est expérimentale — consultez la doc officielle"
            ;;
        x86_64)
            info "Architecture détectée: Intel ($arch)"
            ;;
        *)
            warning "Architecture non standard: $arch — poursuite avec prudence"
            ;;
    esac
}

check_prerequisites() {
    local missing=()
    
    # Outils système requis
    for cmd in curl sudo hdiutil installer diskutil; do
        command -v "$cmd" >/dev/null 2>&1 || missing+=("$cmd")
    done
    
    if [[ ${#missing[@]} -gt 0 ]]; then
        error "Outils manquants: ${missing[*]}"
        error "Installez Xcode Command Line Tools: xcode-select --install"
        return 1
    fi
    
    # Vérifier l'espace disque (~2 Go requis)
    local free_space
    free_space="$(df -k "$DOWNLOAD_DIR" | awk 'NR==2 {print $4}')"
    if [[ $free_space -lt 2097152 ]]; then  # 2 Go en Ko
        error "Espace disque insuffisant dans $DOWNLOAD_DIR (requis: ~2 Go)"
        return 1
    fi
    
    # Vérifier que VirtualBox n'est pas en cours d'exécution
    if pgrep -x "VirtualBox" >/dev/null 2>&1; then
        warning "VirtualBox est en cours d'exécution. Tentative d'arrêt..."
        if [[ "$DRY_RUN" == false ]]; then
            killall VirtualBox 2>/dev/null || true
            sleep 3
            if pgrep -x "VirtualBox" >/dev/null 2>&1; then
                error "Impossible de fermer VirtualBox. Veuillez le quitter manuellement."
                return 1
            fi
        fi
    fi
    
    success "Prérequis vérifiés"
    return 0
}

validate_version() {
    local ver="$1"
    if [[ ! "$ver" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
        error "Format de version invalide: '$ver' (attendu: X.Y.Z, ex: 7.0.12)"
        return 1
    fi
    return 0
}

validate_build() {
    local build="$1"
    if [[ ! "$build" =~ ^[0-9]+$ ]]; then
        error "Build number invalide: '$build' (chiffres uniquement)"
        return 1
    fi
    return 0
}

fetch_latest_version() {
    local latest
    info "Récupération de la dernière version disponible..."
    
    if ! latest="$(curl -fsSL --retry 3 --retry-delay 2 \
        'https://download.virtualbox.org/virtualbox/LATEST.TXT' 2>/dev/null | tr -d '\n\r ')"; then
        warning "Impossible de récupérer la version depuis LATEST.TXT"
        return 1
    fi
    
    if validate_version "$latest"; then
        success "Dernière version détectée: $latest"
        echo "$latest"
        return 0
    else
        error "Version récupérée invalide: '$latest'"
        return 1
    fi
}

#===============================================================================
# 🧹 Fonctions de Cleanup & Gestion d'Erreurs
#===============================================================================

cleanup() {
    local exit_code=$?
    
    debug "Nettoyage en cours (exit code: $exit_code)..."
    
    # Démonter le volume DMG si encore monté
    if [[ -n "${MOUNTDIR:-}" ]] && [[ -d "$MOUNTDIR" ]]; then
        if [[ "$DRY_RUN" == false ]]; then
            debug "Démontage de: $MOUNTDIR"
            diskutil unmount "$MOUNTDIR" 2>/dev/null || warning "Impossible de démonter $MOUNTDIR"
        fi
    fi
    
    # Supprimer le dossier temporaire
    if [[ -d "$TEMP_DIR" ]]; then
        debug "Suppression du dossier temporaire: $TEMP_DIR"
        rm -rf "$TEMP_DIR"
    fi
    
    # Nettoyage post-installation si demandé
    if [[ "$CLEANUP" == true ]] && [[ "$exit_code" -eq 0 ]]; then
        info "Nettoyage des fichiers téléchargés..."
        for file in "${DOWNLOADED_FILES[@]:-}"; do
            if [[ -f "$file" ]]; then
                debug "Suppression: $file"
                rm -f "$file" 2>/dev/null || warning "Impossible de supprimer $file"
            fi
        done
        # Supprimer le dossier de build si vide
        local build_dir
        build_dir="$(dirname "${DOWNLOADED_FILES[0]:-}")"
        [[ -d "$build_dir" ]] && rmdir "$build_dir" 2>/dev/null || true
    fi
    
    if [[ $exit_code -eq 0 ]]; then
        success "Script terminé avec succès"
    else
        error "Script terminé avec des erreurs (code: $exit_code)"
    fi
    
    exit $exit_code
}

# Enregistrer le trap de cleanup
trap cleanup EXIT INT TERM

#===============================================================================
# 📥 Fonctions de Téléchargement
#===============================================================================

download_file() {
    local url="$1"
    local output="$2"
    local description="$3"
    
    info "Téléchargement: $description"
    debug "URL: $url"
    debug "Destination: $output"
    
    if [[ "$DRY_RUN" == true ]]; then
        warning "[DRY-RUN] curl -fsSL --retry 3 -o '$output' '$url'"
        return 0
    fi
    
    if curl -fsSL --retry 3 --retry-delay 2 -o "$output" "$url"; then
        # Vérifier que le fichier n'est pas vide
        if [[ -s "$output" ]]; then
            success "$description téléchargé"
            DOWNLOADED_FILES+=("$output")
            return 0
        else
            error "Fichier téléchargé vide: $output"
            rm -f "$output"
            return 1
        fi
    else
        error "Échec du téléchargement: $description"
        return 1
    fi
}

download_virtualbox_files() {
    local version="$1"
    local build="$2"
    local base_url="https://download.virtualbox.org/virtualbox/${version}"
    
    # Créer le dossier de destination
    local target_dir="${DOWNLOAD_DIR}/VirtualBox_${version}_Build_${build}"
    mkdir -p "$target_dir"
    info "Dossier de téléchargement: $target_dir"
    
    # Fichiers à télécharger
    local files=(
        "VirtualBox-${version}-${build}-OSX.dmg|VirtualBox Installer"
        "VBoxGuestAdditions_${version}.iso|Guest Additions"
        "Oracle_VM_VirtualBox_Extension_Pack-${version}-${build}.vbox-extpack|Extension Pack"
    )
    
    for entry in "${files[@]}"; do
        local filename="${entry%%|*}"
        local description="${entry##*|}"
        local filepath="${target_dir}/${filename}"
        
        # Skip Extension Pack si option activée
        if [[ "$filename" == *.vbox-extpack ]] && [[ "$SKIP_EXTPACK" == true ]]; then
            debug "Extension Pack ignoré (--skip-extpack)"
            continue
        fi
        
        download_file "${base_url}/${filename}" "$filepath" "$description" || return 1
    done
    
    success "Tous les fichiers téléchargés"
    return 0
}

#===============================================================================
# 🔧 Fonctions d'Installation
#===============================================================================

install_virtualbox() {
    local dmg_path="$1"
    
    info "Montage du fichier DMG: $(basename "$dmg_path")"
    
    if [[ "$DRY_RUN" == true ]]; then
        warning "[DRY-RUN] hdiutil mount '$dmg_path'"
        MOUNTDIR="/Volumes/VirtualBox"
        return 0
    fi
    
    # Monter le DMG et récupérer le point de montage
    local mount_output
    if ! mount_output="$(hdiutil mount "$dmg_path" 2>&1)"; then
        error "Échec du montage du DMG"
        debug "$mount_output"
        return 1
    fi
    
    # Extraire le chemin du volume monté (dernière ligne, colonne 3)
    MOUNTDIR="$(echo "$mount_output" | tail -1 | awk '{$1=$2=""; print $0}' | xargs)"
    debug "Volume monté sur: $MOUNTDIR"
    
    # Trouver et installer le package .pkg
    local pkg_file
    pkg_file="$(find "$MOUNTDIR" -name "*.pkg" -type f | head -1)"
    
    if [[ -z "$pkg_file" ]]; then
        error "Aucun fichier .pkg trouvé dans le DMG"
        return 1
    fi
    
    info "Installation du package: $(basename "$pkg_file")"
    
    if ! sudo installer -pkg "$pkg_file" -target /; then
        error "Échec de l'installation du package"
        return 1
    fi
    
    success "VirtualBox installé avec succès"
    return 0
}

unmount_dmg() {
    if [[ -n "${MOUNTDIR:-}" ]] && [[ -d "$MOUNTDIR" ]]; then
        info "Démontage du volume: $MOUNTDIR"
        if [[ "$DRY_RUN" == false ]]; then
            diskutil unmount "$MOUNTDIR" 2>/dev/null || warning "Impossible de démonter $MOUNTDIR"
        fi
        MOUNTDIR=""
    fi
}

install_extension_pack() {
    local extpack_path="$1"
    
    if [[ "$SKIP_EXTPACK" == true ]]; then
        debug "Installation de l'Extension Pack ignorée"
        return 0
    fi
    
    if [[ ! -f "$extpack_path" ]]; then
        warning "Extension Pack non trouvé: $extpack_path"
        return 0
    fi
    
    info "Installation de l'Extension Pack..."
    
    if [[ "$DRY_RUN" == true ]]; then
        warning "[DRY-RUN] sudo vboxmanage extpack install '$extpack_path' --replace"
        return 0
    fi
    
    # L'Extension Pack nécessite une acceptation de licence interactive
    # On utilise --replace pour mettre à jour si déjà installé
    if sudo vboxmanage extpack install "$extpack_path" --replace; then
        success "Extension Pack installé"
        return 0
    else
        warning "L'installation de l'Extension Pack peut nécessiter une validation manuelle dans VirtualBox"
        return 0  # Non-bloquant
    fi
}

verify_installation() {
    info "Vérification de l'installation..."
    
    # Recharger le PATH si nécessaire
    hash -r 2>/dev/null || true
    
    local vbox_version
    if vbox_version="$(vboxmanage --version 2>/dev/null)"; then
        success "VirtualBox installé: $vbox_version"
        
        # Afficher les extension packs installés
        if ! $SKIP_EXTPACK; then
            debug "Extension packs installés:"
            vboxmanage list extpacks 2>/dev/null | head -10 || true
        fi
        return 0
    else
        error "VirtualBox n'est pas accessible dans le PATH"
        warning "Essayez de redémarrer votre terminal ou d'exécuter: source ~/.zshrc"
        return 1
    fi
}

#===============================================================================
# 🎮 Fonctions d'Interaction Utilisateur
#===============================================================================

prompt_user_inputs() {
    echo
    info "Mode interactif — Veuillez répondre aux questions suivantes:"
    echo
    
    # Demander la version
    while [[ -z "$VERSION" ]]; do
        read -rp "📦 Version de VirtualBox à installer (ex: 7.0.12): " VERSION
        if ! validate_version "$VERSION"; then
            VERSION=""
            echo
        fi
    done
    
    # Demander le build number
    while [[ -z "$BUILD" ]]; do
        read -rp "🔢 Numéro de build Oracle (ex: 150234): " BUILD
        if ! validate_build "$BUILD"; then
            BUILD=""
            echo
        fi
    done
    
    success "Configuration: VirtualBox v${VERSION} build ${BUILD}"
}

parse_arguments() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --version)
                VERSION="$2"
                shift 2
                ;;
            --build)
                BUILD="$2"
                shift 2
                ;;
            --auto-version)
                AUTO_VERSION=true
                shift
                ;;
            --skip-extpack)
                SKIP_EXTPACK=true
                shift
                ;;
            --dry-run)
                DRY_RUN=true
                info "🧪 Mode DRY-RUN activé — aucune modification ne sera appliquée"
                shift
                ;;
            --verbose)
                VERBOSE=true
                shift
                ;;
            --cleanup)
                CLEANUP=true
                shift
                ;;
            --download-dir)
                DOWNLOAD_DIR="$2"
                shift 2
                ;;
            --help|-h)
                print_banner
                show_help
                exit 0
                ;;
            *)
                error "Option inconnue: $1"
                echo "Utilisez --help pour afficher l'aide"
                exit 1
                ;;
        esac
    done
}

#===============================================================================
# 🚀 Fonction Principale
#===============================================================================

main() {
    print_banner
    
    # Parser les arguments en ligne de commande
    parse_arguments "$@"
    
    # Créer le dossier de log si nécessaire
    mkdir -p "$(dirname "$LOG_FILE")" 2>/dev/null || true
    
    # Détecter l'architecture
    detect_architecture
    
    # Vérifier les prérequis
    check_prerequisites || exit 1
    
    # Obtenir version/build si non fournis
    if [[ -z "$VERSION" ]] || [[ -z "$BUILD" ]]; then
        if [[ "$AUTO_VERSION" == true ]] && [[ -z "$VERSION" ]]; then
            VERSION="$(fetch_latest_version)" || {
                warning "Détection automatique échouée, bascule en mode interactif"
                prompt_user_inputs
            }
        else
            prompt_user_inputs
        fi
    fi
    
    # Valider les entrées finales
    validate_version "$VERSION" || exit 1
    validate_build "$BUILD" || exit 1
    
    info "🎯 Cible: VirtualBox v${VERSION} build ${BUILD}"
    
    # Créer le dossier temporaire
    mkdir -p "$TEMP_DIR"
    
    # Télécharger les fichiers
    download_virtualbox_files "$VERSION" "$BUILD" || exit 1
    
    # Installer VirtualBox
    local dmg_file
    dmg_file="$(find "$DOWNLOAD_DIR" -name "VirtualBox-${VERSION}-${BUILD}-OSX.dmg" -type f | head -1)"
    
    if [[ -z "$dmg_file" ]]; then
        error "Fichier DMG introuvable après téléchargement"
        exit 1
    fi
    
    install_virtualbox "$dmg_file" || exit 1
    unmount_dmg
    
    # Installer l'Extension Pack
    local extpack_file
    extpack_file="$(find "$DOWNLOAD_DIR" -name "Oracle_VM_VirtualBox_Extension_Pack-${VERSION}-${BUILD}.vbox-extpack" -type f | head -1)"
    
    if [[ -n "$extpack_file" ]]; then
        install_extension_pack "$extpack_file" || true  # Non-bloquant
    fi
    
    # Vérification finale
    verify_installation
    
    # Message de conclusion
    echo
    success "🎉 Mise à jour VirtualBox terminée avec succès !"
    info "Pour commencer: ouvrez VirtualBox depuis /Applications ou via: open -a VirtualBox"
    
    if [[ "$DRY_RUN" == true ]]; then
        echo
        warning "⚠️  Mode DRY-RUN: Aucune modification réelle n'a été appliquée"
    fi
}

# 🏁 Point d'entrée
main "$@"
